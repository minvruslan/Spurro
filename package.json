{
  "name": "vancloak",
  "private": true,
  "scripts": {
    "dev": "pnpm run \"/^dev:(frontend|backend-api|backend-worker)$/\"",
    "dev:frontend": "pnpm --filter @vancloak/frontend dev",
    "dev:backend-api": "pnpm --filter @vancloak/backend api",
    "dev:backend-worker": "pnpm --filter @vancloak/backend dev:worker",
    "build": "pnpm --filter @vancloak/frontend build && pnpm --filter @vancloak/backend build",
    "build:frontend": "pnpm --filter @vancloak/frontend build",
    "build:backend": "pnpm --filter @vancloak/backend build",
    "build:command-runner-image": "pnpm --filter @vancloak/infrastructure build:command-runner-image",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @vancloak/backend test",
    "test:backend:unit": "pnpm --filter @vancloak/backend test:unit",
    "test:backend:unit:watch": "pnpm --filter @vancloak/backend test:unit:watch",
    "test:backend:integration": "pnpm --filter @vancloak/backend test:integration",
    "test:backend:coverage": "pnpm --filter @vancloak/backend test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint:check": "pnpm -r lint:check",
    "lint:fix": "pnpm -r lint:fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "full-check": "pnpm format:check && pnpm lint:check && pnpm typecheck",
    "full-fix": "pnpm format:fix && pnpm lint:fix && pnpm typecheck"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1"
  }
}
